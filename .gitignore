# Allowlist model: everything is ignored, then tracked paths are added back. The root holds how to
# work (CLAUDE/AGENTS), the working log (WORKSPACE) and the language decks. Everything else written
# goes in temp/, tracked. Clones, agent scratch and run output live under workspace/, never tracked.
# Trial material was removed 2026-08-20; it is in history <= c20f601, as is site/ <= 5b97988.

# workspace/ holds the repo clones being worked on and all scratch — never tracked here
workspace/

# ignore everything by default, then allowlist back in
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/WORKSPACE.md
!/learn
!/temp

# learn/ — Q/A decks for spaced repetition, one file per language
/learn/*
!/learn/*.md

# temp/ — everything written that is not WORKSPACE.md; text only, no artifacts
!/temp/**
# render-review-docs.sh regenerates these two from their .md siblings
/temp/dios/ARCHITECTURE.html
/temp/dios/DIOS-PRD.html
/temp/**/*.pdf
/temp/**/*.rrd
/temp/**/*.db
/temp/**/*.mp4
/temp/**/*.webm

# python
**/__pycache__/
*.pyc
.pytest_cache/

# os
.DS_Store

# secrets — never belongs in git history even privately
credentials.md
