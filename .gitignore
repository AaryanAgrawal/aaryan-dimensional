# Allowlist model: everything is ignored, then tracked paths are added back. This repo
# tracks durable context only — how to work (CLAUDE/AGENTS), the working log (WORKSPACE),
# robot setup, templates, dios design docs, the /dimensional page, and the learn decks.
# Everything else — clones, agent scratch, run output, drafts — lives under workspace/,
# untracked. Trial material was removed 2026-08-20; it is in git history <= c20f601.

# workspace/ holds the repo clones being worked on and all scratch — never tracked here
workspace/

# ignore everything by default, then allowlist back in
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/WORKSPACE.md
!/G1_SETUP_GUIDE.md
!/G1_WIPE_AND_REINSTALL.md
!/dios
!/learn
!/linear-migration
!/scripts
!/site
!/templates

# dios/ — our design docs and the script that renders them; generated HTML stays out
/dios/*
!/dios/*.md
!/dios/render-review-docs.sh
!/dios/review-document.css

# learn/ — Q/A decks for spaced repetition, one file per language
/learn/*
!/learn/*.md

# linear-migration/ — Engineering v1 -> v2 planning, Linear snapshot, review site
!/linear-migration/**

# scripts/ — robot bringup and one-click setup
/scripts/*
!/scripts/*.sh
!/scripts/*.md

# templates/ — the PRD template, markdown source + rendered form
/templates/*
!/templates/*.md
!/templates/*.html

# site/ — the /dimensional page source + assets (canonical copy; deploys from the portfolio repo)
/site/*
!/site/*.tsx
!/site/*.ts
!/site/assets
/site/assets/*
!/site/assets/*.png
!/site/assets/*.gif
!/site/assets/flow
/site/assets/flow/*
!/site/assets/flow/*.png

# python
**/__pycache__/
*.pyc
.pytest_cache/

# os
.DS_Store

# secrets — never belongs in git history even privately
credentials.md
