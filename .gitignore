# Allowlist model: everything is ignored, then tracked paths are added back. The root holds how to
# work (CLAUDE/AGENTS), the working log (WORKSPACE), the language decks, and the /dimensional page.
# Everything else written goes in temp/, tracked. Clones, agent scratch and run output live under
# workspace/, never tracked. Trial material was removed 2026-08-20; it is in history <= c20f601.

# workspace/ holds the repo clones being worked on and all scratch — never tracked here
workspace/

# ignore everything by default, then allowlist back in
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/WORKSPACE.md
!/learn
!/site
!/temp

# learn/ — Q/A decks for spaced repetition, one file per language
/learn/*
!/learn/*.md

# temp/ — everything written that is not WORKSPACE.md; text only, no artifacts
!/temp/**
/temp/**/*.pdf
/temp/**/*.rrd
/temp/**/*.db
/temp/**/*.mp4
/temp/**/*.webm

# site/ — the /dimensional page source + assets (canonical copy; deploys from the portfolio repo)
/site/*
!/site/*.tsx
!/site/*.ts
!/site/assets
/site/assets/*
!/site/assets/*.png
!/site/assets/*.gif
!/site/assets/flow
/site/assets/flow/*
!/site/assets/flow/*.png

# python
**/__pycache__/
*.pyc
.pytest_cache/

# os
.DS_Store

# secrets — never belongs in git history even privately
credentials.md
